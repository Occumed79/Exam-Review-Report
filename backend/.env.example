# Parse-HIPAA Backend Configuration

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=1337
SERVER_URL=http://localhost:1337/parse

# Frontend URL (for CORS)
FRONTEND_URL=https://exam-review-report.onrender.com

# Parse Server Keys
PARSE_APP_ID=sme-risk-engine-app
PARSE_MASTER_KEY=your-secure-master-key-here
PARSE_REST_API_KEY=your-secure-rest-api-key-here

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/sme_risk_engine

# Logging
LOG_LEVEL=info

# Email Configuration (optional)
EMAIL_FROM=noreply@sme-risk-engine.com
EMAIL_DOMAIN=sme-risk-engine.com
EMAIL_API_KEY=your-email-api-key

# HIPAA Compliance
HIPAA_ENCRYPTION_KEY=your-encryption-key-for-phi
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years as per HIPAA requirements

# AI/Intelligence APIs
VITE_GEMINI_KEY=your-gemini-key
VITE_GEMINI_BACKUP_KEY=your-gemini-backup-key
VITE_MISTRAL_KEY=your-mistral-key
VITE_GROQ_KEY=your-groq-key
VITE_OPENROUTER_KEY=your-openrouter-key
VITE_TAVILY_KEY=your-tavily-key
VITE_EXA_KEY=your-exa-key
VITE_FIRECRAWL_KEY=your-firecrawl-key
VITE_BROWSERBASE_KEY=your-browserbase-key
VITE_YOU_API_KEY=your-you-api-key
VITE_JINA_KEY=your-jina-key
VITE_SERPER_KEY=your-serper-key
VITE_OCR_SPACE_KEY=your-ocr-space-key
VITE_MINIMAX_KEY=your-minimax-key
VITE_OLOSTEP_KEY=your-olostep-key
